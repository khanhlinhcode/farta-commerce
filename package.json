{
  "name": "farta-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Greenfield FARTA commerce monorepo",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --stream -r --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "test:browser": "pnpm --filter @farta/api seed:development && playwright test",
    "test:browser:staging": "E2E_TARGET=staging playwright test",
    "test:browser:update": "pnpm --filter @farta/api seed:development && playwright test --update-snapshots",
    "test:browser:install": "playwright install chromium",
    "format:check": "prettier --check .",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "infra:up": "docker compose -f infrastructure/docker/compose.yml up -d --wait mongodb redis && docker compose -f infrastructure/docker/compose.yml run --rm mongo-init",
    "infra:down": "docker compose -f infrastructure/docker/compose.yml down"
  },
  "devDependencies": {
    "@farta/eslint-config": "workspace:*",
    "@playwright/test": "1.64.0",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "overrides": {
      "body-parser": "2.4.0",
      "multer": "2.5.0",
      "qs": "6.16.1"
    },
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild"
    ]
  }
}

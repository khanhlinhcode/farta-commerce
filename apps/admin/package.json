{
  "name": "@farta/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "build:cloudflare:staging": "VITE_STOREFRONT_URL=https://staging.fartacommerce.me pnpm run build",
    "preview:cloudflare": "pnpm run build && wrangler dev",
    "deploy:cloudflare": "pnpm run build && wrangler deploy",
    "deploy:cloudflare:staging": "pnpm run build:cloudflare:staging && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run"
  },
  "dependencies": {
    "@farta/design-tokens": "workspace:*",
    "@farta/types": "workspace:*",
    "@farta/ui": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.50.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.89.0",
    "react-router-dom": "7.18.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@farta/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.151.1"
  }
}

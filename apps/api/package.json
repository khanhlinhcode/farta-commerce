{
  "name": "@farta/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker:reservations": "node dist/workers/reservation-expiry.worker.js",
    "worker:reservations:once": "node dist/workers/reservation-expiry-once.js",
    "worker:reservations:dev": "node scripts/dev.mjs dist/workers/reservation-expiry.worker.js",
    "bootstrap:owner": "pnpm build && node dist/scripts/bootstrap-owner.js",
    "seed:development": "pnpm build && node --env-file=.env dist/scripts/development-seed.js",
    "seed:staging-sample": "node dist/scripts/staging-sample-seed.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.mts"
  },
  "dependencies": {
    "@farta/types": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/mongoose": "12.0.0",
    "@nestjs/platform-express": "12.1.2",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie": "1.0.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "5.10.0",
    "mongoose": "9.10.4",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@farta/config": "workspace:*",
    "@nestjs/testing": "12.1.2",
    "@types/bcrypt": "6.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "catalog:",
    "vitest": "5.0.3"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "farta-storefront-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "staging.fartacommerce.me",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "vars": {
    "API_INTERNAL_URL": "https://api-staging.fartacommerce.me",
    "CATALOG_CACHE_MODE": "no-store",
    "SITEMAP_DATA_POLICY": "required",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "ddkizvngm",
    "NEXT_PUBLIC_SITE_URL": "https://staging.fartacommerce.me",
    "NEXT_PUBLIC_INDEXABLE": "false",
  },
}

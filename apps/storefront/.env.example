# Server-side only. Never prefix provider/database secrets with NEXT_PUBLIC_.
API_INTERNAL_URL=http://localhost:4000
# Use `no-store` only for low-traffic staging when durable ISR storage is not configured.
CATALOG_CACHE_MODE=revalidate
# Use `required` for staging/production deployment builds. An indexable
# deployment is always treated as required even when this value is omitted.
SITEMAP_DATA_POLICY=optional
# Public provider account identifier only; never put the API secret here.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_INDEXABLE=false

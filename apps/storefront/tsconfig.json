{
  "extends": "@farta/config/tsconfig/react",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "incremental": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vitest.setup.ts",
    "vitest.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}

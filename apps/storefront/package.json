{
  "name": "@farta/storefront",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "build:cloudflare": "CLOUDFLARE_WORKERS=1 CATALOG_CACHE_MODE=no-store opennextjs-cloudflare build",
    "build:cloudflare:staging": "API_INTERNAL_URL=https://api-staging.fartacommerce.me SITEMAP_DATA_POLICY=required NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ddkizvngm NEXT_PUBLIC_SITE_URL=https://staging.fartacommerce.me NEXT_PUBLIC_INDEXABLE=false pnpm run build:cloudflare",
    "preview:cloudflare": "pnpm run build:cloudflare && opennextjs-cloudflare preview",
    "deploy:cloudflare": "pnpm run build:cloudflare && opennextjs-cloudflare deploy",
    "deploy:cloudflare:staging": "pnpm run build:cloudflare:staging && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@farta/design-tokens": "workspace:*",
    "@farta/types": "workspace:*",
    "@farta/ui": "workspace:*",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "7.89.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@farta/config": "workspace:*",
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "rclone.js": "0.6.6",
    "tailwindcss": "4.3.3",
    "typescript": "catalog:",
    "vitest": "5.0.3",
    "wrangler": "4.151.1"
  }
}

# Runtime
APP_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Exact number of trusted reverse-proxy hops. Keep 0 for direct local traffic.
TRUST_PROXY_HOPS=0

# Local development only. directConnection avoids Docker's internal `mongodb`
# hostname during replica-set discovery from the host. Production must provide
# its own managed replica-set URI through the deployment secret store.
MONGODB_URI=mongodb://127.0.0.1:27017/farta?replicaSet=rs0&directConnection=true
REDIS_URL=redis://localhost:6379/0

# Generate independent high-entropy values. Placeholders intentionally do not boot production.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-byte-secret
CSRF_SECRET=replace-with-a-third-independent-at-least-32-byte-secret
CART_CREDENTIAL_SECRET=replace-with-a-fourth-independent-at-least-32-byte-secret
JWT_ISSUER=farta-api
JWT_CUSTOMER_AUDIENCE=farta-storefront
JWT_STAFF_AUDIENCE=farta-admin
JWT_ACCESS_TTL_SECONDS=300
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
BCRYPT_COST=12
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REFRESH_LIMIT=60
AUTH_REFRESH_WINDOW_SECONDS=300
CART_MAX_ITEM_QUANTITY=10
GUEST_CART_TTL_SECONDS=2592000
CUSTOMER_CART_TTL_SECONDS=7776000
CART_MUTATION_LIMIT=120
CART_MUTATION_WINDOW_SECONDS=300
CART_MERGE_LIMIT=20
CART_MERGE_WINDOW_SECONDS=300

# Transactional commerce. Values are explicit business configuration.
CHECKOUT_RESERVATION_TTL_SECONDS=900
RESERVATION_WORKER_INTERVAL_MS=15000
RESERVATION_WORKER_BATCH_SIZE=50
SHIPPING_FLAT_FEE_VND=30000
# Leave blank to disable free shipping. Otherwise use an integer VND threshold.
FREE_SHIPPING_THRESHOLD_VND=
ORDER_LOOKUP_SECRET=replace-with-a-fifth-independent-at-least-32-byte-secret
CHECKOUT_LIMIT=20
CHECKOUT_WINDOW_SECONDS=300
ORDER_LOOKUP_LIMIT=10
ORDER_LOOKUP_WINDOW_SECONDS=300
PAYMENT_INITIATE_LIMIT=20
PAYMENT_INITIATE_GLOBAL_LIMIT=100
PAYMENT_INITIATE_WINDOW_SECONDS=300
PAYMENT_STATUS_LIMIT=120
PAYMENT_STATUS_GLOBAL_LIMIT=600
PAYMENT_STATUS_WINDOW_SECONDS=300

# Read-only AI Product Advisor. Keep disabled until both internal secrets and
# an AI service deployment are configured. Generate independent random values.
AI_ENABLED=false
AI_SERVICE_URL=http://localhost:8000
AI_ALLOW_STAGING_PRIVATE_HTTP=false
AI_GATEWAY_SHARED_SECRET=
AI_TOOLS_SHARED_SECRET=
AI_CONVERSATION_SECRET=
AI_INTERNAL_REQUEST_TOLERANCE_SECONDS=60
AI_REQUEST_TIMEOUT_MS=65000
AI_CHAT_LIMIT=30
AI_CHAT_WINDOW_SECONDS=300
AI_CONVERSATION_TTL_SECONDS=1800

# AI provider flags are consumed only by apps/ai-service. Keep both disabled
# until the actual account is confirmed to be free-tier and keys are injected
# through the deployment secret store.
AI_GEMINI_ENABLED=false
AI_GEMINI_FREE_TIER_VERIFIED=false
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash-lite
AI_GROQ_ENABLED=false
AI_GROQ_FREE_TIER_VERIFIED=false
AI_GROQ_API_KEY=
AI_GROQ_MODEL=openai/gpt-oss-120b
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_ENABLED=false
# Shared Redis is mandatory whenever the AI service is enabled. It protects
# inbound gateway nonces and, during an approved canary, provider HTTP budget.
AI_PROVIDER_BUDGET_REDIS_URL=redis://localhost:6379/0
AI_PROVIDER_BUDGET_ENABLED=false
AI_PROVIDER_BUDGET_CANARY_ID=
AI_PROVIDER_BUDGET_MAX_REQUESTS=7
AI_PROVIDER_BUDGET_TTL_SECONDS=3600
AI_MAX_AGENT_ITERATIONS=3
AI_MAX_TOOL_EXECUTIONS=3
AI_MAX_HISTORY_TURNS=6
AI_OUTPUT_TOKEN_LIMIT=768
AI_REQUEST_TIMEOUT_SECONDS=60
AI_LLM_TIMEOUT_SECONDS=25
AI_TOOL_TIMEOUT_SECONDS=6
AI_RAG_ENABLED=false
# Local-only, one-shot P2-B ingestion gate. Never set this in staging or production.
ALLOW_LOCAL_RAG_REBUILD=
SEPAY_ENABLED=false
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_TOLERANCE_SECONDS=300
SEPAY_PAYMENT_CODE_PREFIX=FAR
SEPAY_DEPOSIT_MODE=DISABLED
SEPAY_DEPOSIT_FIXED_VND=
SEPAY_DEPOSIT_BASIS_POINTS=

# Explicit development-only owner bootstrap. Keep blank unless running the
# one-shot `pnpm --filter @farta/api bootstrap:owner` command locally.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_DISPLAY_NAME=
DEVELOPMENT_SEED_ACTOR_EMAIL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_MAX_BYTES=10000000

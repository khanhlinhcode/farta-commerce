# Runtime
APP_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
# Exact number of trusted reverse-proxy hops. Keep 0 for direct local traffic.
TRUST_PROXY_HOPS=0

# Local development only; replace through the deployment secret store.
MONGODB_URI=mongodb://localhost:27017/farta?replicaSet=rs0
REDIS_URL=redis://localhost:6379/0

# Generate independent high-entropy values. Placeholders intentionally do not boot production.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-byte-secret
CSRF_SECRET=replace-with-a-third-independent-at-least-32-byte-secret
CART_CREDENTIAL_SECRET=replace-with-a-fourth-independent-at-least-32-byte-secret
JWT_ISSUER=farta-api
JWT_CUSTOMER_AUDIENCE=farta-storefront
JWT_STAFF_AUDIENCE=farta-admin
JWT_ACCESS_TTL_SECONDS=300
SESSION_IDLE_TTL_SECONDS=604800
SESSION_ABSOLUTE_TTL_SECONDS=2592000
BCRYPT_COST=12
AUTH_LOGIN_LIMIT=10
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_REFRESH_LIMIT=60
AUTH_REFRESH_WINDOW_SECONDS=300
CART_MAX_ITEM_QUANTITY=10
GUEST_CART_TTL_SECONDS=2592000
CUSTOMER_CART_TTL_SECONDS=7776000
CART_MUTATION_LIMIT=120
CART_MUTATION_WINDOW_SECONDS=300
CART_MERGE_LIMIT=20
CART_MERGE_WINDOW_SECONDS=300

# Transactional commerce. Values are explicit business configuration.
CHECKOUT_RESERVATION_TTL_SECONDS=900
SHIPPING_FLAT_FEE_VND=30000
# Leave blank to disable free shipping. Otherwise use an integer VND threshold.
FREE_SHIPPING_THRESHOLD_VND=
ORDER_LOOKUP_SECRET=replace-with-a-fifth-independent-at-least-32-byte-secret
CHECKOUT_LIMIT=20
CHECKOUT_WINDOW_SECONDS=300
ORDER_LOOKUP_LIMIT=10
ORDER_LOOKUP_WINDOW_SECONDS=300
PAYMENT_INITIATE_LIMIT=20
PAYMENT_INITIATE_GLOBAL_LIMIT=100
PAYMENT_INITIATE_WINDOW_SECONDS=300
PAYMENT_STATUS_LIMIT=120
PAYMENT_STATUS_GLOBAL_LIMIT=600
PAYMENT_STATUS_WINDOW_SECONDS=300
SEPAY_ENABLED=false
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_TOLERANCE_SECONDS=300
SEPAY_PAYMENT_CODE_PREFIX=FAR
SEPAY_DEPOSIT_MODE=DISABLED
SEPAY_DEPOSIT_FIXED_VND=
SEPAY_DEPOSIT_BASIS_POINTS=

# Explicit development-only owner bootstrap. Keep blank unless running the
# one-shot `pnpm --filter @farta/api bootstrap:owner` command locally.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_DISPLAY_NAME=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_MAX_BYTES=10000000
